{
  "name": "rumu-mcp",
  "version": "1.0.0",
  "description": "Rumu V2 MCP server — natural-language CRM control over the existing /api/v1 REST API",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bundle": "esbuild dist/index.js --bundle --platform=node --format=cjs --target=node18 --outfile=runtime-bundles/rumu-mcp.cjs",
    "start:http": "node dist/http.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@types/node": "^24.19.2",
    "typescript": "^5.9.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "vitest": "^4.1.12"
  }
}
