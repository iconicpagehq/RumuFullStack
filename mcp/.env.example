# Rumu API target. Local dev: http://127.0.0.1:8000/api/v1
# Production MUST be HTTPS.
RUMU_API_BASE=https://api.rumu.in/api/v1

# Sanctum Personal Access Token of the Rumu user operating through ChatGPT.
# Never commit a real token. Create per-user tokens with least privilege.
RUMU_TOKEN=

RUMU_REQUEST_TIMEOUT_MS=15000
RUMU_MAX_RETRIES=2
RUMU_PAGE_SIZE=20
RUMU_MIN_INTERVAL_MS=200
MCP_CONFIRM_TTL_SECONDS=300
MCP_LOG_RETENTION_DAYS=7
MCP_LOG_PATH=.mcp-log.jsonl
NODE_ENV=production

# --- Hosted gateway (node dist/http.js) -------------------------------------
# The gateway serves MCP over HTTP (POST /mcp) so ChatGPT web/app and other
# remote MCP clients can connect. Leave RUMU_TOKEN empty here: every request
# carries its own OAuth bearer token (see /.well-known/oauth-authorization-server).
#
# Local dev defaults:
#   RUMU_MCP_PORT=8787
#   RUMU_MCP_HOST=127.0.0.1        (use 0.0.0.0 behind a reverse proxy)
#   RUMU_MCP_PUBLIC_ORIGIN=http://127.0.0.1:8787
#   RUMU_OAUTH_TARGET=http://127.0.0.1:8000   (derived from RUMU_API_BASE if unset)
#
# Production example (TLS terminated at the proxy):
#   RUMU_MCP_PUBLIC_ORIGIN=https://mcp.rumu.in
#   RUMU_OAUTH_TARGET=https://api.rumu.in
#   RUMU_MCP_HOST=127.0.0.1  RUMU_MCP_PORT=8787
#RUMU_MCP_PORT=8787
#RUMU_MCP_HOST=127.0.0.1
#RUMU_MCP_PUBLIC_ORIGIN=
#RUMU_OAUTH_TARGET=

