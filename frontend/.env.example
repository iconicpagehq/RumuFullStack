# Use /api/v1 in development (Vite proxies to the Laravel server).
# In production point this at the API origin, e.g. https://api.rumu.in/api/v1
VITE_API_BASE_URL=/api/v1

# Public storage origin for avatars and uploaded files.
# Development uses the Vite /storage proxy; production needs an absolute URL.
# VITE_STORAGE_BASE_URL=https://api.rumu.in/storage
