APP_NAME=Rumu
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=rumu_v2
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CORS / Sanctum SPA
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://app.rumu.in
SANCTUM_STATEFUL_DOMAINS=localhost:5173,app.rumu.in
# Production: SESSION_DOMAIN=.rumu.in

# Google OAuth (Social Login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8000/auth/google/callback

# Facebook OAuth (Social Login)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URL=http://localhost:8000/auth/facebook/callback

# Meta Lead Ads & Pages
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
META_GRAPH_VERSION=v19.0
META_REDIRECT_URI=http://localhost:5173/auth/meta/callback
META_WEBHOOK_VERIFY_TOKEN=

# Meta Conversions API for CRM (reverse signal / lead quality)
# Create a CRM Dataset in Meta Events Manager, then use a System User token.
META_CAPI_ENABLED=false
META_CAPI_DATASET_ID=
META_CAPI_ACCESS_TOKEN=
META_CAPI_GRAPH_VERSION=v25.0
META_CAPI_LEAD_EVENT_SOURCE="Rumu App"
META_CAPI_SEND_ON_IMPORT=true

# Billing / Payments
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# App calling & call recordings
# Calls start in the Rumu Android app and sync recordings here.
CALL_RECORDING_DISK=local
CALL_RECORDING_RETENTION_DAYS=90
CALL_RECORDING_MAX_BYTES=52428800
CALL_DAILY_LIMIT_PER_USER=50
CALL_BACKFILL_DAYS=180
CALL_APP_MIN_VERSION=1.0.0
